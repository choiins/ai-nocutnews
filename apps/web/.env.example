# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # 서버 액션/관리자/적재용

# 관리자 페이지(/admin) 접근 허용 이메일 — 콤마 구분. 이 목록의 로그인 이메일만 요약 수정·삭제·톱 배치 가능.
ADMIN_EMAILS=cbsnewslab@gmail.com

# 스키마 마이그레이션용 (scripts/migrate.mjs) — Postgres 연결 문자열(URI)
# Supabase 대시보드 > Project Settings > Database > Connection string
SUPABASE_DB_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-...pooler.supabase.com:5432/postgres

# OpenRouter — RSS 요약 적재(scripts/ingest.mjs)용
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=google/gemini-2.5-flash   # 비추론 모델 권장(추론 모델은 JSON이 잘려 요약 실패)

# 보존 기간(일) — 이보다 오래된 RSS 기사는 ingest 시 자동 삭제(Supabase 무료 500MB 유지). 기본 30
RETENTION_DAYS=30

# YouTube 키는 필요 없다 — Watch는 채널 RSS(youtube.com/feeds/videos.xml)를 직접 파싱한다.
# src/lib/youtube.ts 참고.
